---
import business from "../data/business.json";
import Icon from "./Icon.astro";
const { headline, subtext } = Astro.props;
---
<aside class="callout" aria-label="Call for appliance repair">
  <div class="wrap">
    <div class="callout-inner">
      <div class="callout-copy">
        <p class="callout-headline">{headline}</p>
        {subtext && <p class="callout-sub">{subtext}</p>}
      </div>
      <a href={`tel:${business.phoneHref}`} class="btn-call">
        <Icon name="phone" size={22} />
        <span>{business.phone}</span>
      </a>
    </div>
  </div>
</aside>
