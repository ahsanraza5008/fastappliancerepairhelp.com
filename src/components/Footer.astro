---
import business from "../data/business.json";
const nav = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services/" },
  { name: "Service Areas", url: "/service-areas/" },
  { name: "About", url: "/about/" },
  { name: "Contact", url: "/contact/" },
];
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <p class="footer-name">{business.name}</p>
      <p>Same day appliance repair for refrigerators, washers, dryers, dishwashers, ovens and more, in all 50 states.</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-nav">
        {nav.map((item) => <li><a href={item.url}>{item.name}</a></li>)}
      </ul>
    </nav>
    <div class="footer-call">
      <p>Phones answered 24/7</p>
      <a href={`tel:${business.phoneHref}`}>{business.phone}</a>
    </div>
  </div>
  <div class="wrap">
    <p class="footer-base">&copy; <span data-year>{new Date().getFullYear()}</span> {business.name}</p>
  </div>
</footer>
