---
import business from "../data/business.json";
import Icon from "./Icon.astro";
const nav = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services/" },
  { name: "Service Areas", url: "/service-areas/" },
  { name: "About", url: "/about/" },
  { name: "Contact", url: "/contact/" },
];
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href="/">
      <span class="logo-mark" aria-hidden="true"><Icon name="washer-repair" size={22} /></span>
      <span class="logo-text">{business.name}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.url}>{item.name}</a></li>)}
      </ul>
    </nav>
    <a class="header-call" href={`tel:${business.phoneHref}`}>
      <Icon name="phone" size={18} />
      <span>{business.phone}</span>
    </a>
  </div>
</header>
