---
// items: [{ name, url }] — the same array feeds breadcrumbSchema() so both trails match.
const { items = [] } = Astro.props;
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="wrap">
    <ol>
      {items.map((item, i) => (
        <li>
          {i < items.length - 1
            ? <a href={item.url}>{item.name}</a>
            : <span aria-current="page">{item.name}</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>
