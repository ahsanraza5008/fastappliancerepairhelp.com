---
import Base from "../layouts/Base.astro";
import CtaBlock from "../components/CtaBlock.astro";
import business from "../data/business.json";
import services from "../data/services.json";
import states from "../data/states.json";
import { statePath } from "../lib/paths.js";

const metaTitle = "Appliance Repair Nationwide | Same Day Service";
const metaDescription =
  "Appliance repair for refrigerators, washers, dryers, ovens and dishwashers across the US. Same day service, upfront pricing and 24/7 help. Call now.";

const proof = [
  { label: "24/7 help", desc: "The line is answered nights, weekends and holidays." },
  { label: "Same day service", desc: "Morning calls usually get an afternoon visit." },
  { label: "Upfront pricing", desc: "You hear the price and approve it before any work starts." },
  { label: "Clean work", desc: "Floors covered, old parts hauled out, kitchen left as found." },
];

const symptoms = [
  { q: "The fridge is running but nothing is cold.", p: "Usually a stalled evaporator fan, iced-over coils, a failed defrost part or a start relay. Food is at risk after about four hours, so this is the call we get most." },
  { q: "The washer stopped with water still in it.", p: "Often a clogged drain pump or a failed lid switch." },
  { q: "The dryer turns but the clothes stay damp.", p: "Heating element, thermal fuse, or a blocked vent." },
  { q: "There's water sitting in the bottom of the dishwasher.", p: "Filter, drain pump, or a kinked drain hose." },
  { q: "The oven never reaches the temperature I set.", p: "Bake element, igniter, or temperature sensor." },
  { q: "The ice maker quit and the freezer feels soft.", p: "Water valve, frozen fill tube, or a defrost fault." },
  { q: "The microwave runs but the food comes out cold.", p: "Magnetron, diode or a door switch. Not a DIY repair." },
  { q: "The disposal hums but won't turn.", p: "A jammed flywheel or a worn motor." },
];

const faqs = [
  {
    q: "How fast can an appliance repair technician get to me?",
    a: [
      "In most areas, calling before early afternoon gives you the best chance of a same day visit.",
      "When you call, we check which technicians near your ZIP code have an opening and give you the earliest arrival window. Busy seasons, like a heat wave when refrigerators fail all over town, can push that window to the next morning, and we tell you so on the call.",
    ],
  },
  {
    q: "How much does appliance repair cost?",
    a: [
      "The cost is a diagnostic visit plus the part and labor for the fix, and you approve that total before work begins.",
      "The biggest factors are the part itself (a dryer thermal fuse is cheap, a refrigerator compressor is not), the brand, and whether the part is in stock or has to be ordered. If the repair costs more than the appliance is worth, the technician will say so.",
    ],
  },
  {
    q: "Should I repair my appliance or replace it?",
    a: [
      "A common rule: if the repair costs less than half the price of a comparable new appliance and the unit is under about ten years old, repairing usually makes sense.",
      "Sealed-system refrigerator failures and cracked washer tubs on older units are the usual cases where replacing wins. You get the repair price first, so you can decide with real numbers.",
    ],
  },
  {
    q: "Which appliance brands do your technicians work on?",
    a: [
      "Most major household brands, including Whirlpool, GE, Samsung, LG, Frigidaire, Maytag, KitchenAid, Bosch and Electrolux.",
      "Tell us the brand and model number when you call so the technician can check part availability before arriving. High-end built-in brands may need a specialist, and we will tell you if that applies.",
    ],
  },
  {
    q: "Can I call at night or on a weekend?",
    a: [
      "Yes. The phone line is answered 24 hours a day, every day of the year.",
      "A late-night call gets you advice on keeping the problem contained and the first open appointment, which is often early the next morning.",
    ],
  },
  {
    q: "What should I have ready before the technician arrives?",
    a: [
      "The model and serial number, a short description of what the appliance is doing, and clear access to it.",
      "The model tag is usually inside the fridge door frame, under the dishwasher door edge, behind the oven drawer, or on the back of a washer or dryer lid. A phone photo of it is enough.",
    ],
  },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: business.name,
  telephone: business.phone,
  url: `https://${business.domain}`,
  areaServed: "United States",
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") },
  })),
};
const fmt = (n) => n.toLocaleString("en-US");
---
<Base metaTitle={metaTitle} metaDescription={metaDescription} schema={[orgSchema, faqSchema]}>

  <!-- 1. Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="hero-pain">The fridge is warm, the washer is full of water, or the oven won't heat, and you need it working today.</p>
        <h1>Same Day Appliance Repair Across the United States</h1>
        <p class="hero-lead">
          One call connects you with an appliance repair technician who works in your area. Refrigerators, washers, dryers, dishwashers, ovens and more, diagnosed and fixed at your home, usually the same day.
        </p>
        <div class="hero-action" data-callbar-trigger>
          <a class="btn-call" href={`tel:${business.phoneHref}`}>
            <span class="led" aria-hidden="true"></span>
            <span>Call {business.phone}</span>
          </a>
          <p class="hero-micro">Tell us the appliance and what it's doing. We'll give you the earliest arrival window near you before you hang up.</p>
        </div>
      </div>
      <div class="panel">
        <p class="panel-title">What every call includes</p>
        <ul class="panel-list">
          {proof.map((p) => (
            <li>
              <span class="led" aria-hidden="true"></span>
              <strong>{p.label}</strong>
              <span class="desc">{p.desc}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Problem recognition -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Which of these is happening in your kitchen or laundry room?</h2>
        <p>These are the problems people describe when they call us, in their own words. Every one of them is a routine repair.</p>
      </div>
      <ul class="symptoms">
        {symptoms.map((s, i) => (
          <li class={i === 0 ? "symptom symptom-lead" : "symptom"}>
            <q>{s.q}</q>
            <p>{s.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBlock
    headline="Recognize your appliance in that list?"
    subtext="Describe the symptom on the phone and we'll match you with a technician who repairs it."
  />

  <!-- 3. What we do -->
  <section class="section section-enamel">
    <div class="wrap">
      <div class="section-head">
        <h2>What appliance repair do you need?</h2>
        <p>Technicians repair the appliances that run your kitchen and laundry room, in your home, with common parts carried on the truck.</p>
      </div>
      <ul class="spec">
        {services.map((s) => (
          <li>
            <h3><a href={`/services/#${s.slug}`}>{s.name}</a></h3>
            <p>{s.line}</p>
          </li>
        ))}
      </ul>
      <p class="section-foot"><a href="/services/">See how each appliance repair works, from diagnosis to the final test</a></p>
    </div>
  </section>

  <!-- 4. Why contact us -->
  <section class="section section-ink">
    <div class="wrap">
      <div class="section-head">
        <h2>Why call us instead of searching for a repair shop yourself?</h2>
        <p>Because you get a confirmed appointment in one call, not a voicemail chain.</p>
      </div>
      <ul class="usps">
        <li>
          <p class="usp-label"><span class="led" aria-hidden="true"></span>24/7 Help</p>
          <p>A person answers at 2 a.m. on a Sunday, tells you how to keep the leak or the warm fridge contained, and books the first opening.</p>
        </li>
        <li>
          <p class="usp-label"><span class="led" aria-hidden="true"></span>Same Day Service</p>
          <p>Technicians keep time open for same-day calls, so a broken fridge in the morning is often running again by evening.</p>
        </li>
        <li>
          <p class="usp-label"><span class="led" aria-hidden="true"></span>Clean Work</p>
          <p>Drop cloths go down before the appliance moves, the old parts leave with the technician, and the floor is wiped before they go.</p>
        </li>
        <li>
          <p class="usp-label"><span class="led" aria-hidden="true"></span>Upfront Pricing</p>
          <p>After the diagnosis you get the full repair price, parts and labor together. Nothing starts until you say yes.</p>
        </li>
      </ul>
    </div>
  </section>

  <CtaBlock
    headline="Want the earliest opening near you?"
    subtext="We check technician schedules by ZIP code while you're on the line."
  />

  <!-- 5. Service coverage -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Appliance Repair by State: Find Coverage in Your Area</h2>
        <p>
          We work with independent technicians in all 50 states and Washington, D.C. Pick your state to find your city, or see how it works on the <a href="/service-areas/">appliance repair service areas page</a>.
        </p>
      </div>
      <ul class="state-grid">
        {states.map((s) => (
          <li>
            <a href={statePath(s)}>
              <span class="state-name">{s.name}</span>
              <span class="state-count">{fmt(s.cityCount)} cities</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. When to call + what to do now -->
  <section class="section section-enamel">
    <div class="wrap two-col">
      <div>
        <h2>When should you call for appliance repair?</h2>
        <p class="answer">Call when the appliance stops doing its main job, or when anything involves water on the floor, a burning smell, or gas.</p>
        <ul class="checks">
          <li>The refrigerator or freezer is above 40°F (fridge) or 0°F (freezer) and climbing.</li>
          <li>Water is pooling under the washer, dishwasher or fridge.</li>
          <li>The dryer smells hot or the cabinet feels hotter than usual.</li>
          <li>A gas range or oven smells of gas. Leave the house first and call the gas company, then us.</li>
          <li>A breaker trips every time the appliance runs.</li>
          <li>The same error code keeps coming back after a reset.</li>
        </ul>
      </div>
      <div class="panel-light">
        <h3>What to do while you wait</h3>
        <ol class="steps">
          <li><div><strong>Cut the power or water</strong><p>Unplug the unit or switch off its breaker. For leaks, close the supply valve behind the appliance or under the sink.</p></div></li>
          <li><div><strong>Keep the cold in</strong><p>Keep fridge and freezer doors closed. A full freezer holds temperature for about 48 hours; a fridge for about 4.</p></div></li>
          <li><div><strong>Find the model number</strong><p>Take a photo of the model tag so the technician can check parts before arriving.</p></div></li>
          <li><div><strong>Clear a path</strong><p>Move what's around the appliance so it can be pulled out and reached from behind.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <CtaBlock
    headline="Water on the floor or food warming up?"
    subtext="Call now and we'll walk you through containing it while a technician is booked."
  />

  <!-- 7. FAQ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Appliance repair questions people ask before calling</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q}</h3></summary>
            <div class="faq-body">
              {f.a.map((para) => <p>{para}</p>)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Final CTA -->
  <section class="final-band">
    <div class="wrap">
      <h2>Get your appliance repaired today, wherever you are in the US.</h2>
      <p>Same day service in most areas, a price you approve before work starts, and help on the phone 24 hours a day.</p>
      <a class="final-phone" href={`tel:${business.phoneHref}`}>
        <span class="led" aria-hidden="true"></span>{business.phone}
      </a>
    </div>
  </section>

</Base>
