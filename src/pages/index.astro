---
import Base from "../layouts/Base.astro";
import CtaBlock from "../components/CtaBlock.astro";
import Icon from "../components/Icon.astro";
import business from "../data/business.json";
import services from "../data/services.json";
import states from "../data/states.json";
import { statePath } from "../lib/paths.js";

const metaTitle = "Appliance Repair Near You | Same Day, 24/7 Help";
const metaDescription =
  "Same day appliance repair for refrigerators, washers, dryers, dishwashers and ovens in your city. Upfront pricing, clean work and 24/7 help. Call today.";

const proof = [
  { label: "24/7 help", desc: "Nights, weekends and holidays." },
  { label: "Same day service", desc: "Call in the morning, fixed by evening in most areas." },
  { label: "Upfront pricing", desc: "One price for parts and labor, approved by you first." },
  { label: "Clean work", desc: "Floors covered, old parts and packaging taken away." },
];

const process = [
  { t: "Call and describe it", d: "Tell us the appliance, the brand and what it's doing. A sentence or two is enough to know which parts might be needed." },
  { t: "Get your arrival window", d: "You get a time slot before you hang up, usually the same day. The technician calls ahead when on the way." },
  { t: "Diagnosis and your price", d: "The technician finds the fault and gives you one price for parts and labor. Nothing is repaired until you approve it." },
  { t: "Repair, test, clean up", d: "The fix is made, the appliance is run through a full cycle in front of you, and the work area is left clean." },
];

const symptoms = [
  { s: "The fridge is running but nothing inside is cold", c: "Usually the evaporator fan, iced-over coils, a defrost failure or the start relay.", tag: "Most common call. Food is at risk after about 4 hours." },
  { s: "The washer stopped with water still in the drum", c: "A clogged drain pump, a failed lid lock, or a kinked drain hose." },
  { s: "The dryer spins but the clothes stay damp", c: "Heating element, thermal fuse, or a lint-packed vent line." },
  { s: "There's dirty water in the bottom of the dishwasher", c: "A clogged filter, the drain pump, or a stuck check valve." },
  { s: "The oven never gets up to temperature", c: "Bake element, a weak gas igniter, or the temperature sensor." },
  { s: "The ice maker stopped and the freezer feels soft", c: "Frozen fill tube, water inlet valve, or a defrost problem." },
  { s: "The microwave runs but the food comes out cold", c: "Magnetron, high-voltage diode, or a door switch. Not a safe DIY job." },
  { s: "The disposal hums but won't turn", c: "A jammed flywheel or a motor near the end of its life." },
];

const faqs = [
  {
    q: "How soon can a technician get to my home?",
    a: [
      "Most same day appointments go to people who call before early afternoon.",
      "We look at the schedule for your area while you're on the phone and give you an arrival window right then. During heat waves, when refrigerators fail all at once, the first slot can slide to the next morning, and you'll know that before you hang up.",
    ],
  },
  {
    q: "How much will my appliance repair cost?",
    a: [
      "You pay for the diagnosis plus the part and labor for the fix, and you approve the full amount before any work starts.",
      "What moves the price most is the part. A dryer thermal fuse is inexpensive; a refrigerator compressor is not. Brand and whether the part is on hand also matter. When a repair would cost more than the appliance is worth, the technician tells you.",
    ],
  },
  {
    q: "Is it worth fixing, or should I buy a new one?",
    a: [
      "If the repair costs less than half the price of a comparable new unit and the appliance is under about ten years old, fixing it usually pays off.",
      "Sealed-system failures on older refrigerators and cracked washer tubs are the typical cases where replacing makes more sense. Because you get the price first, you decide with real numbers in hand.",
    ],
  },
  {
    q: "Do you work on my brand?",
    a: [
      "Yes for most household brands, including Whirlpool, GE, Samsung, LG, Frigidaire, Maytag, KitchenAid, Bosch and Electrolux.",
      "Give us the model number when you call so the right parts can be checked before the visit.",
    ],
  },
  {
    q: "Do you answer the phone at night and on weekends?",
    a: [
      "Yes, the line is answered around the clock, every day of the year.",
      "A late call gets you help containing the problem tonight and the first open appointment, often early the next morning.",
    ],
  },
  {
    q: "Do I need to do anything before the technician arrives?",
    a: [
      "Have the model number ready, clear a path to the appliance, and keep pets in another room.",
      "The model tag is usually inside the fridge door frame, on the edge of the dishwasher door, behind the oven drawer, or under the washer or dryer lid. A phone photo of it is perfect.",
    ],
  },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: business.name,
  telephone: business.phone,
  url: `https://${business.domain}`,
  areaServed: "United States",
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") },
  })),
};
const fmt = (n) => n.toLocaleString("en-US");
---
<Base metaTitle={metaTitle} metaDescription={metaDescription} schema={[orgSchema, faqSchema]}>

  <!-- 1. Hero -->
  <section class="hero">
    <div class="wrap">
      <ul class="hero-kicker" aria-label="Common problems">
        <li>Fridge warm?</li>
        <li>Washer won't drain?</li>
        <li>Oven won't heat?</li>
      </ul>
      <h1>Same Day Appliance Repair Near You</h1>
      <p class="hero-lead">
        Tell us what your appliance is doing and a technician comes to your home to diagnose it and fix it, usually the same day. You hear the price before anything is touched.
      </p>
      <div class="hero-action" data-callbar-trigger>
        <a class="btn-call" href={`tel:${business.phoneHref}`}>
          <Icon name="phone" size={22} />
          <span>Call {business.phone}</span>
        </a>
        <p class="hero-micro">Describe the problem in a sentence or two and you get an arrival window on the same call.</p>
      </div>
      <ul class="proof">
        {proof.map((p) => (
          <li>
            <span class="tick"><Icon name="check" size={18} /></span>
            <span><strong>{p.label}</strong><span class="desc">{p.desc}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. Problem recognition -->
  <section class="section">
    <div class="wrap">
      <div class="section-intro">
        <h2>What is your appliance doing right now?</h2>
        <p>Find the line that matches. On the right is what's usually behind it, and every one is a routine appliance repair.</p>
      </div>
      <table class="symptom-table">
        <thead>
          <tr><th scope="col">What you're seeing</th><th scope="col">What's usually behind it</th></tr>
        </thead>
        <tbody>
          {symptoms.map((row, i) => (
            <tr class={i === 0 ? "top" : undefined}>
              <th scope="row">{row.s}</th>
              <td>{row.c}{row.tag && <span class="tag">{row.tag}</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <CtaBlock
    headline="Spotted your problem in that list?"
    subtext="Read the line to us on the phone and we'll book the repair."
  />

  <!-- 3. What we do -->
  <section class="section section-mist">
    <div class="wrap">
      <div class="section-intro">
        <h2>Appliance repair for every machine in the kitchen and laundry room</h2>
        <p>Pick yours to see the problems we fix most often on it.</p>
      </div>
      <ul class="tiles">
        {services.map((s) => (
          <li class="tile">
            <a href={`/services/#${s.slug}`}>
              <span class="tile-icon"><Icon name={s.slug} size={30} /></span>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
            </a>
          </li>
        ))}
      </ul>
      <p class="more-link"><a href="/services/">How our appliance repair service works, start to finish</a></p>
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="section">
    <div class="wrap">
      <div class="section-intro">
        <h2>How our appliance repair service works</h2>
        <p>From your call to a working appliance, usually in the same day.</p>
      </div>
      <ol class="process">
        {process.map((step) => (
          <li>
            <h3>{step.t}</h3>
            <p>{step.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBlock
    headline="Want the first opening today?"
    subtext="The earlier you call, the better the chance of a same day visit."
  />

  <!-- 5. Service coverage -->
  <section class="section section-mist">
    <div class="wrap">
      <div class="section-intro">
        <h2>Appliance Repair by State: Find Coverage in Your Area</h2>
        <p>
          Choose your state to find same day appliance repair in your city, or browse every <a href="/service-areas/">appliance repair service area</a>.
        </p>
      </div>
      <ul class="state-grid">
        {states.map((s) => (
          <li>
            <a href={statePath(s)}>
              <span class="state-name">{s.name}</span>
              <span class="state-count">{fmt(s.cityCount)} cities</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. When to call + what to do now -->
  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Is it time to call for appliance repair?</h2>
        <p class="capsule">Yes, if the appliance has stopped doing its main job, or if there's water on the floor, a burning smell, or gas.</p>
        <ul class="signs">
          <li><Icon name="check" size={20} /><span>The fridge is above 40°F or the freezer is above 0°F and still climbing.</span></li>
          <li><Icon name="check" size={20} /><span>Water is pooling under the washer, dishwasher or refrigerator.</span></li>
          <li><Icon name="check" size={20} /><span>The dryer smells hot or the cabinet is hotter than usual to the touch.</span></li>
          <li><Icon name="check" size={20} /><span>The breaker trips every time the appliance starts.</span></li>
          <li><Icon name="check" size={20} /><span>The same error code comes back after every reset.</span></li>
          <li><Icon name="check" size={20} /><span>You smell gas near a range or oven. Leave the house and call the gas utility first, then call us.</span></li>
        </ul>
      </div>
      <div class="wait">
        <h3>What to do while you wait</h3>
        <ol>
          <li><div><strong>Turn off power or water</strong><p>Unplug it or flip its breaker. For a leak, close the supply valve behind the appliance or under the sink.</p></div></li>
          <li><div><strong>Keep the doors shut</strong><p>A closed fridge stays cold for about 4 hours; a full freezer for about 48.</p></div></li>
          <li><div><strong>Photograph the model tag</strong><p>It lets the technician check parts before arriving.</p></div></li>
          <li><div><strong>Make some room</strong><p>Clear the area so the appliance can be pulled out and reached from behind.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <CtaBlock
    headline="Leak on the floor or food warming up?"
    subtext="Call now and we'll talk you through containing it while the repair is booked."
  />

  <!-- 7. FAQ -->
  <section class="section section-mist">
    <div class="wrap faq-layout">
      <div class="section-intro">
        <h2>Appliance repair questions, answered</h2>
        <p>Still unsure? The phone is the fastest answer: {business.phone}.</p>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q}</h3></summary>
            <div class="faq-body">
              {f.a.map((para) => <p>{para}</p>)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Final CTA -->
  <section class="final">
    <div class="wrap final-grid">
      <div>
        <h2>Your appliance can be working again today.</h2>
        <p>Same day appliance repair, a price you approve first, and a clean kitchen when we leave. In your city, any hour.</p>
      </div>
      <a class="final-phone" href={`tel:${business.phoneHref}`}>
        <small>Call or tap, 24/7</small>
        <strong>{business.phone}</strong>
      </a>
    </div>
  </section>

</Base>
